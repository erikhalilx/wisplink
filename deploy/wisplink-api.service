[Unit]
Description=WispLink API
After=network.target

[Service]
User=wisplink
Group=wisplink
EnvironmentFile=/etc/wisplink/wisplink.env
WorkingDirectory=/opt/wisplink
StateDirectory=wisplink
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/wisplink/.venv/bin/uvicorn wisplink.app:create_app --factory --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log --limit-concurrency=24
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
